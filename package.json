{
  "name": "mcp-server-surepetcare",
  "version": "0.2.0",
  "description": "MCP server for the SurePetcare API (SureFlap, SureFeed)",
  "keywords": ["mcp", "surepetcare", "sureflap", "cat-flap", "pet"],
  "author": "Dirk-Jan Faber",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dirkjanfaber/mcp-server-surepetcare.git"
  },
  "homepage": "https://github.com/dirkjanfaber/mcp-server-surepetcare#readme",
  "bugs": {
    "url": "https://github.com/dirkjanfaber/mcp-server-surepetcare/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "mcp-server-surepetcare": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.6.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "axios-mock-adapter": "^1.22.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.0"
  },
  "jest": {
    "preset": "ts-jest",
    "extensionsToTreatAsEsm": [".ts"],
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "useESM": true }]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "roots": [
      "<rootDir>/src/__tests__"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  }
}
